# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It is the authoritative list of variables and README
# tells you to copy it, so ignoring it left a fresh clone with nothing to copy.
# It carries names and reasoning, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env*.local
.env

# visual-diff scratch
*.png
shot*.mjs
# ...except assets the app actually serves. Without this the wordmark is a 404
# on every deployment while looking fine locally, which is the worst shape a
# missing file can take.
!public/*.png
