# Copy to .env.local for local development. Never commit the filled-in file.

# ---- Dakota platform ----
# The sandbox API key. One key serves every visitor; tenancy is the per-visitor
# platform customer, not the key.
DAKOTA_API_KEY=

# Which Dakota environment to talk to: 'sandbox' or 'production'. Unset ⇒
# sandbox. Nothing else is accepted — anything else throws at startup rather
# than pointing the demo at a host it cannot reach.
#
# The SDK carries the URL for each one, so this names the environment rather
# than a host.
#
# ⚠️ 'production' moves REAL money. The defaults elsewhere in this file assume
# sandbox: DEMO_NETWORKS is a testnet list and NEXT_PUBLIC_DEMO_TEST_FUNDS
# offers a faucet that only exists there. Change those together or not at all.
# DAKOTA_ENV=sandbox

# ---- Sign-in (Google, work accounts only) ----
# The browser token client, same as the Go build — so no client secret and no
# redirect URI. The only requirement is that the page's origin is on the OAuth
# client's "Authorized JavaScript origins" list.
#
# Not a secret: it ships to every browser that loads the sign-in page.
GOOGLE_CLIENT_ID=

# openssl rand -base64 32
AUTH_SECRET=

# Vercel sets this automatically in production. Needed locally only if you are
# not on the default port.
# AUTH_URL=http://localhost:3000

# Local testing without a Google OAuth client: sign in by typing any address.
# The credentials provider is not even CONSTRUCTED unless this is exactly
# 'true', so there is no dormant endpoint on a real deployment.
# DEMO_DEV_LOGIN=true

# Derives the service signer that seeds every wallet's signer group. MUST be
# stable across deploys — a different value derives a different key, and every
# existing wallet would reference a signer the platform has never seen.
DEMO_KEY_SALT=

# Domains admitted despite the work-account rule — the escape hatch for a
# prospect whose domain reads as personal. Comma-separated.
# DEMO_ALLOW_DOMAINS=friend.dev,acme-partner.io

# Let ANY Google account in, personal ones included. The domain is still
# recorded — it is the useful part — it just stops deciding who gets in.
#
# The trade: leads then include gmail.com addresses, which name a person rather
# than a company, and the company name is the reason the gate existed. Right for
# an open demo day, wrong for a lead-gen campaign.
# DEMO_ALLOW_ANY_DOMAIN=true

# The opposite gate: let ONLY these domains in. Empty means no restriction,
# which is the public demo. Set it when a deployment is for one company.
# DEMO_REQUIRE_DOMAIN=acme.com, acme.io

# ---- Tenancy ----
# 'team' ⇒ every signed-in person shares ONE platform customer, its agents and
# its wallets. Anything else (including unset) ⇒ 'visitor', where each person
# gets their own. This decides who can see whose money, so it is not a
# preference — a deployment is one or the other on purpose.
# TENANCY_MODE=team

# The shared customer, in team mode. Unset ⇒ resolved by name on first boot.
# TEAM_CUSTOMER_ID=
# TEAM_CUSTOMER_NAME=

# ---- Demo shape (all optional; the defaults are the public demo) ----
# What the platform customer is called. Default 'Agentic Demo'.
# DEMO_CUSTOMER_NAME=

# Networks payments may use. Default is a TESTNET list — a deployment pointed
# at production must set this, or it offers chains its customer never chose.
# DEMO_NETWORKS=base-mainnet, ethereum-mainnet

# The asset a one-click limit is written in. Default USDC.
# DEMO_LIMIT_ASSET=USDC

# How "next Friday" is read when an agent schedules. Default America/New_York.
# DEMO_TIMEZONE=Europe/Madrid

# Shows the "add test funds" button. Set ONLY where a faucet actually exists —
# on a deployment without one the button is a promise nothing keeps.
# NEXT_PUBLIC_DEMO_TEST_FUNDS=true

# ---- Storage ----
# Postgres. Use a POOLED connection string (Neon's -pooler host, Supabase's
# pgBouncer port): serverless opens many short-lived connections and will
# exhaust a direct Postgres endpoint.
DATABASE_URL=

# ---- Slack (optional; unset ⇒ the integration is off) ----
# Both must be set. Slack cannot reach localhost, so for local testing run
# `ngrok http 3000` and use the https URL it prints as the Event Subscriptions
# Request URL: <ngrok-url>/api/slack/events
#
# Socket Mode must be OFF. With it on, Slack stops sending HTTP — the Request
# URL verifies and then nothing is ever delivered.
# SLACK_BOT_TOKEN=xoxb-…
# SLACK_SIGNING_SECRET=
# APP_BASE_URL=https://<your-deployment-or-ngrok-url>

# Shared secret Vercel Cron presents on the settlement sweep. Vercel sets this
# for you when you add a cron; set it locally only to exercise the route.
# CRON_SECRET=

# ---- Lead capture (optional; unset ⇒ nothing is sent anywhere) ----
# Who is trying the demo. The verified work domain names the COMPANY evaluating
# Dakota, which is the reason sign-in insists on a work Google account.
#
# OAuth 2.0 Client Credentials Flow, same as the Go services: the key and
# secret are exchanged for an access token. No user is involved, and the
# connected app needs "Client Credentials Flow" enabled with a run-as user.
#
# Failures never affect sign-in — a visitor we turn away costs more than a lead
# we fail to record.
# SALESFORCE_INSTANCE_URL=https://yourinstance.my.salesforce.com
# SALESFORCE_CONSUMER_KEY=
# SALESFORCE_CONSUMER_SECRET=

# ---- Inbound email (optional) ----
# Forward an invoice, get a drafted payment. Postmark receives the mail and
# POSTs it to /api/email/inbound already parsed, attachments decoded.
#
# The address Postmark issued for the inbound stream. NEXT_PUBLIC_ because the
# Integrations tab shows it — it is an inbox address, not a secret.
# NEXT_PUBLIC_POSTMARK_INBOUND_ADDRESS=xxxxxxxx@inbound.postmarkapp.com

# Guards the webhook. Postmark sends no signature, so the URL carries this and
# the route refuses anything without it — otherwise whoever guessed the endpoint
# could feed invoices straight to an agent. Set the Postmark webhook URL to:
#   https://<deployment>/api/email/inbound?secret=<this value>
# POSTMARK_WEBHOOK_SECRET=

# Optional: reply by email with the drafted plan. Sending needs a verified
# sender signature in Postmark, one step more than receiving — so without these
# the invoice is still read and drafted, it just lands in the app instead.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM=agent@yourdomain.com
